# /opt/lead-agent/.env on the VPS (chmod 600). Never commit the real file.

N8N_HOSTNAME=n8n.example.com
ACME_EMAIL=admin@example.com
# 32+ random characters. Changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=

# Claude API key from console.anthropic.com.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Supabase (CRM: contacts, events, suppression, listings).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Behaviour
AGENT_AUTO_SEND=false                    # kill switch: false = every draft goes to AGENT_ESCALATION_EMAIL for review
AGENT_ESCALATION_EMAIL=                  # who handles escalations
AGENT_DIGEST_EMAIL=                      # daily digest recipients (comma separated); defaults to escalation
AGENT_BCC_EMAIL=                         # copy of every auto-reply (blank for none)
AGENT_FORM_NOTIFY_EMAIL=                 # where website form enquiries are forwarded
AGENT_OWN_ADDRESSES=                     # our own mailboxes (comma separated): never answered, allowed in replies
AGENT_MAX_AUTO_REPLIES_24H=3
AGENT_URL_ALLOWLIST=                     # the only domains a reply may link to (comma separated)

# Mailbox the agent reads (IMAP) and sends from (SMTP). Start with a test mailbox.
AGENT_FROM="Harbour Key Properties <info@harbourkey.example>"
AGENT_IMAP_HOST=
AGENT_IMAP_PORT=993
AGENT_IMAP_USER=
AGENT_IMAP_PASS=
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USER=
AGENT_SMTP_PASS=

# WhatsApp (Meta Cloud API). The agent stays unpublished until the first three are set.
# AGENT_WA_VERIFY_TOKEN is created by the deploy.
AGENT_WA_TOKEN=                          # System User token for the Meta app (never expires), with whatsapp_business_messaging
AGENT_WA_APP_SECRET=                     # Meta app > App settings > Basic > App Secret; checks Meta's webhook signatures
AGENT_WA_PHONE_NUMBER_ID=                # Meta app > WhatsApp > API Setup > Phone number ID (not the phone number)
AGENT_WA_WABA_ID=                        # WhatsApp Business Account ID; for scripts/wa-template.mjs
AGENT_WA_NUMBER=                         # the WhatsApp number as callers should hear it, e.g. +27000000000
AGENT_WA_AUTO_SEND=false                 # WhatsApp kill switch: false = every draft goes to AGENT_ESCALATION_EMAIL, nothing is sent
AGENT_WA_MAX_AUTO_REPLIES_24H=10         # chats go back and forth, so higher than email
AGENT_WA_TRANSCRIPT_EMAIL=               # where each chat is emailed once quiet for 2 hours; empty = AGENT_ESCALATION_EMAIL
AGENT_WA_CALL_TEMPLATE=                  # call_follow_up once Meta approves it (node scripts/wa-template.mjs status); empty = callers are not WhatsApped

# Phone calls (Asterisk on the host, OpenAI Realtime).
AGENT_VOICE_ENABLED=false                # voice kill switch: false = every call rings AGENT_OFFICE_NUMBER
AGENT_VOICE_TEST_NUMBERS=                # these numbers reach the agent even while it's off (comma separated)
AGENT_OFFICE_NUMBER=                     # where calls go when the agent is off or can't answer (dialled out over the trunk)
OPENAI_API_KEY=                          # platform.openai.com > API keys
AGENT_VOICE_MAX_MINUTES=15               # the agent wraps up a call after this long
# AGENT_VOICE_INTERNAL_KEY and AGENT_ASTERISK_SECRET are added by npm run deploy; leave them alone.
